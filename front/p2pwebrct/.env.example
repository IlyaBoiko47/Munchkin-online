# Свой TURN на VPS (рекомендуется для разных Wi‑Fi). См. turn/docker-compose.yml
# TURN_URLS=turn:YOUR_PUBLIC_IP:3478,turns:YOUR_PUBLIC_IP:5349
# TURN_USERNAME=munchkin
# TURN_PASSWORD=long_random_secret

# Опционально в сборке фронта (если нет /api/webrtc-ice):
# REACT_APP_TURN_URLS=turn:YOUR_PUBLIC_IP:3478,turns:YOUR_PUBLIC_IP:5349
# REACT_APP_TURN_USERNAME=munchkin
# REACT_APP_TURN_CREDENTIAL=long_random_secret
